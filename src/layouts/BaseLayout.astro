---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SeoHead from '@/components/SeoHead.astro';
import MobileStickyCTA from '@/components/MobileStickyCTA.astro';
import SupportWidget from '@/components/SupportWidget.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#080c14" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Yıldızlar Çekici" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="google-site-verification" content="yO4uhL_A4888uQQ6qA5zJEh7-CUiiEIFGYKo6N_BVRQ" />

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z1l2bb1qfk");
    </script>

    <!-- Google tag (gtag.js) - Google Ads -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18457068527"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18457068527');

      // Google Ads dönüşümleri: telefon ve WhatsApp tıklamaları (tüm sayfalarda, tüm butonlarda)
      // Bunlar iletişim bağlantısı tıklamalarıdır; tamamlanan görüşme veya iş değildir.
      // Tekrar ve otomasyon tıklaması filtreleri:
      //  - otomasyon tarayıcıları (webdriver/headless) sayılmaz
      //  - yalnızca gerçek kullanıcı tıklamaları (isTrusted) sayılır
      //  - aynı ziyarette (sekme oturumu) her tür için yalnızca 1 dönüşüm gönderilir
      (function () {
        var ua = navigator.userAgent || '';
        var isBot = navigator.webdriver === true ||
          /HeadlessChrome|PhantomJS|Puppeteer|Playwright|Selenium|bot|crawler|spider|Lighthouse/i.test(ua);
        var sent = {};
        function already(key) {
          if (sent[key]) return true;
          try { if (sessionStorage.getItem('yok_conv_' + key)) return true; } catch (err) {}
          return false;
        }
        function mark(key) {
          sent[key] = true;
          try { sessionStorage.setItem('yok_conv_' + key, '1'); } catch (err) {}
        }
        function fire(key, sendTo) {
          if (already(key)) return;
          mark(key);
          // transport_type beacon: telefon/WhatsApp uygulamasi acilirken sinyal kaybolmasin
          gtag('event', 'conversion', { send_to: sendTo, transport_type: 'beacon' });
        }
        // Nitelikli Arama (birincil dönüşüm):
        // Ara'ya dokunduktan sonra kişi en az QC_MIN_AWAY ms telefon uygulamasında kalırsa sayılır.
        // iPhone'da "Vazgeç" diyen, tuş takımını açıp hemen dönen ve botlar sayılmaz.
        var QC_KEY = 'yok_qc_pending';
        var QC_MIN_AWAY = 15000;
        var QC_TAP_WINDOW = 8000;
        var qcPending = null;
        function qcSave() {
          try { if (qcPending) sessionStorage.setItem(QC_KEY, JSON.stringify(qcPending)); else sessionStorage.removeItem(QC_KEY); } catch (err) {}
        }
        function qcLoad() {
          try { var raw = sessionStorage.getItem(QC_KEY); return raw ? JSON.parse(raw) : null; } catch (err) { return null; }
        }
        function armQualifiedCall() {
          if (already('qcall')) return;
          qcPending = { tapAt: Date.now(), hiddenAt: 0 };
          qcSave();
        }
        function qcCheckReturn(now) {
          if (!qcPending || !qcPending.hiddenAt) return;
          var away = now - qcPending.hiddenAt;
          if (away >= QC_MIN_AWAY && away < 3 * 60 * 60 * 1000) {
            fire('qcall', 'AW-18457068527/Jbb4CI_mmrEdEO-HguFE');
          }
          qcPending = null;
          qcSave();
        }
        document.addEventListener('visibilitychange', function () {
          var now = Date.now();
          if (document.visibilityState === 'hidden') {
            if (qcPending && !qcPending.hiddenAt && now - qcPending.tapAt <= QC_TAP_WINDOW) {
              qcPending.hiddenAt = now;
              qcSave();
            }
          } else {
            qcCheckReturn(now);
          }
        });
        // Tarayıcı geri dönünce sayfayı yeniden yüklediyse bekleyen aramayı burada tamamla
        if (!isBot) {
          qcPending = qcLoad();
          if (qcPending) qcCheckReturn(Date.now());
        }

        document.addEventListener('click', function (e) {
          if (isBot || !e.isTrusted) return;
          var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!link) return;
          var href = (link.getAttribute('href') || '').toLowerCase();
          if (href.indexOf('tel:') === 0) {
            fire('tel', 'AW-18457068527/Yqw3CI3p4aYdEO-HguFE');
            armQualifiedCall();
          } else if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1 || href.indexOf('whatsapp:') === 0) {
            fire('wa', 'AW-18457068527/K_VOCJDp4aYdEO-HguFE');
          }
        }, true);
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font load -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>

    <SeoHead {...seoProps} />
  </head>
  <body class="safe-bottom-space">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand-300 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink-950">
      İçeriğe geç
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SupportWidget />
    <MobileStickyCTA />

    <!-- Scroll-reveal IntersectionObserver -->
    <script>
      const revealItems = document.querySelectorAll('.reveal, .reveal-fade');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        revealItems.forEach((el) => observer.observe(el));
      } else {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
