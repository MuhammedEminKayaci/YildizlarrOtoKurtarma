---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTAButtons from '@/components/CTAButtons.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
import { getServiceImageByTitle } from '@/data/media';
import { createBreadcrumbSchema, createLocalBusinessSchema, createServiceCatalogSchema } from '@/lib/schema';

const breadcrumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hizmetler', href: '/hizmetler/' }
];

const pageTitle = 'Ankara Oto Çekici, Oto Kurtarıcı ve Araç Taşıma Hizmetleri';
const pageDescription =
  'Ankara’da oto çekici, oto kurtarıcı, yol yardım, kayar kasa büyük araç, forklift ve manlift taşıma hizmetlerini inceleyin.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/hizmetler/"
  jsonLd={[createLocalBusinessSchema(), createServiceCatalogSchema({ items: services }), createBreadcrumbSchema(breadcrumbs)]}
>
  <section class="noise-bg light-section">
    <Breadcrumb items={breadcrumbs} />
    <div class="site-container py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="accent-pill mb-5">Hizmetler</p>
        <h1 class="text-[clamp(2.25rem,8vw,4.5rem)] font-semibold leading-[1.02] tracking-normal text-ink-950">Ankara Oto Çekici, Oto Kurtarıcı ve Araç Taşıma</h1>
        <p class="mt-5 text-base leading-7 text-ink-500 md:text-lg">
          {site.name}; acil oto çekici, oto kurtarıcı, yol yardım, kayar kasa büyük araç, forklift ve manlift taşıma ihtiyaçları için profesyonel destek sunar.
        </p>
      </div>
      <div class="mt-8 max-w-3xl text-base leading-8 text-ink-600">
        <p>
          Her hizmet talebinde aracın konumu, araç tipi, yol şartları ve teslim edilecek nokta birlikte değerlendirilir. Amaç, ihtiyacı doğru anlamak ve aracı güvenli şekilde uygun noktaya ulaştırmaktır.
        </p>
      </div>
      <div class="mt-12 grid gap-6">
        {services.map((service, index) => (
          <article class="premium-card grid gap-6 overflow-hidden p-4 md:grid-cols-[0.72fr_0.72fr_1.1fr] md:items-center md:p-5">
            <a href={service.href} class="relative z-10 block overflow-hidden rounded-2xl" aria-label={`${service.title} sayfasına git`}>
              <ResponsiveImage
                image={getServiceImageByTitle(service.title)}
                class="h-52 w-full md:h-56"
                sizes="(min-width: 768px) 28vw, 100vw"
              />
            </a>
            <div class="relative z-10">
              <span class="rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="mt-3 text-2xl font-semibold text-ink-950">{service.title}</h2>
              <p class="mt-4 text-sm leading-6 text-ink-500">{service.description}</p>
            </div>
            <div class="relative z-10 rounded-3xl bg-white p-5 ring-1 ring-ink-900/10">
              <h3 class="text-base font-semibold text-ink-950">Hangi durumda ihtiyaç duyulur?</h3>
              <p class="mt-3 text-sm leading-6 text-ink-600">{service.useCase}</p>
              <div class="mt-5 flex flex-col gap-3 sm:flex-row">
                <a class="btn-primary" href={service.href}>Detayları incele</a>
                <a class="btn-secondary" href="/iletisim/">İletişime geç</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-12 rounded-apple p-8 text-white dark-gradient-surface md:p-10">
        <h2 class="text-3xl font-semibold leading-tight">Hangi hizmete ihtiyacınız olduğundan emin değil misiniz?</h2>
        <p class="muted mt-4 max-w-2xl text-sm leading-6">
          Konumunuzu ve aracın durumunu paylaşın. İhtiyaç çekici, yol yardım veya planlı taşıma ise birlikte netleştirelim.
        </p>
        <div class="mt-7">
          <CTAButtons whatsappLabel="WhatsApp’tan Konum Gönder" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
