---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatsStrip from '@/components/StatsStrip.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import DistrictCard from '@/components/DistrictCard.astro';
import FAQ from '@/components/FAQ.astro';
import ConversionCTA from '@/components/ConversionCTA.astro';
import GalleryPreview from '@/components/GalleryPreview.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
import { districts } from '@/data/districts';
import { faqs } from '@/data/faqs';
import { processSteps } from '@/data/processSteps';
import { whyUsItems } from '@/data/trustItems';
import {
  createFAQSchema,
  createLocalBusinessSchema,
  createOrganizationSchema,
  createWebsiteSchema
} from '@/lib/schema';

const pageTitle       = 'Ankara Oto Çekici ve 7/24 Yol Yardım | Yıldızlar Oto Kurtarma';
const pageDescription = 'Ankara genelinde 7/24 oto çekici, oto kurtarma, yol yardım ve araç taşıma hizmeti. Acil durumlarda hızlı, güvenli ve profesyonel destek.';
const featuredDistricts = districts.slice(0, 8);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  jsonLd={[
    createOrganizationSchema(),
    createWebsiteSchema(),
    createLocalBusinessSchema(),
    createFAQSchema(faqs)
  ]}
>

  <!-- ① HERO — full photo background, text on top -->
  <Hero />

  <!-- ② STATS STRIP -->
  <StatsStrip />

  <!-- ③ PROCESS -->
  <section class="bg-white" style="padding: 80px 0 96px;">
    <div class="site-container">
      <div class="process-grid">
        <div class="reveal">
          <SectionTitle
            eyebrow="Nasıl Çalışır"
            title="Acil durumda süreci sadeleştiriyoruz."
            description={`Konumunuzu paylaşın — ${site.name} ekibi aracın tipini netleştirip en hızlı çözümü uygular.`}
          />
          <div class="trust-pills-row">
            {['Konum paylaşımı', 'Net iletişim', 'Kontrollü taşıma'].map(t => (
              <span class="trust-pill-item">
                <Icon name="circle-check" size={14} strokeWidth={2} />
                {t}
              </span>
            ))}
          </div>
        </div>

        <div class="process-steps">
          {processSteps.map((step, i) => (
            <div class="process-card reveal" style={`animation-delay:${i*70}ms`}>
              <span class="process-num">{i + 1}</span>
              <div>
                <h3 class="process-title">{step.title}</h3>
                <p class="process-desc">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ④ SERVICES -->
  <section style="background:#f5f7fb; padding:80px 0 96px;">
    <div class="site-container">
      <div class="section-header reveal">
        <SectionTitle
          eyebrow="Hizmetler"
          title="Tüm çekici ve yol yardım çözümleri."
          description="Acil çekici, kurtarma, kaza sonrası ve şehirlerarası taşıma hizmetleri."
        />
        <a class="btn-secondary btn-arrow" href="/hizmetler/" style="flex-shrink:0">Tüm hizmetleri gör <Icon name="arrow-right" size={16} strokeWidth={2.25} /></a>
      </div>

      <div class="services-grid">
        {services.slice(0, 5).map((service, i) => (
          <div class:list={['reveal', i === 0 && 'services-featured']} style={`animation-delay:${i*55}ms`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ WHY US -->
  <section class="dark-section noise-bg" style="padding:88px 0 104px;">
    <div class="site-container">
      <div class="text-center reveal" style="margin-bottom:52px">
        <SectionTitle
          eyebrow="Neden Biz"
          tone="dark"
          align="center"
          title={`Neden ${site.name}?`}
          description="Net iletişim, hızlı koordinasyon ve güvenli taşıma — her operasyonda üç temel öncelik."
        />
      </div>
      <div class="whyus-grid">
        {whyUsItems.map((item, i) => (
          <div class="whyus-card reveal" style={`animation-delay:${i*70}ms`}>
            <span class="whyus-ico"><Icon name={item.icon} size={22} strokeWidth={1.9} /></span>
            <h3 class="whyus-title">{item.title}</h3>
            <p class="whyus-desc">{item.description}</p>
            <span class="whyus-index" aria-hidden="true">{`0${i + 1}`}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ DISTRICTS -->
  <section class="bg-white" style="padding:80px 0 96px;">
    <div class="site-container">
      <div class="section-header reveal">
        <SectionTitle
          eyebrow="Hizmet Bölgeleri"
          title="Ankara'nın her ilçesinde çekici."
          description="25 Ankara ilçesi için hızlı ulaşım ve operasyon desteği."
        />
        <a class="btn-secondary btn-arrow" href="/ankara-cekici/" style="flex-shrink:0">Tüm ilçeleri gör <Icon name="arrow-right" size={16} strokeWidth={2.25} /></a>
      </div>
      <div class="districts-grid">
        {featuredDistricts.map((district, i) => (
          <div class="reveal" style={`animation-delay:${i*45}ms`}>
            <DistrictCard {...district} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ GALLERY -->
  <GalleryPreview />

  <!-- ⑧ FAQ -->
  <section style="background:#f5f7fb; padding:80px 0 96px;">
    <div class="site-container">
      <div class="text-center reveal" style="margin-bottom:48px">
        <SectionTitle
          align="center"
          eyebrow="Sık Sorulanlar"
          title="Merak edilen her şey."
          description="Hizmet kapsamı, süreç ve fiyatlandırma hakkında en sık sorulan sorular."
        />
      </div>
      <div class="reveal" style="animation-delay:80ms">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <!-- ⑨ FINAL CTA -->
  <section class="bg-white" style="padding:80px 0 96px;">
    <div class="site-container">
      <div class="reveal">
        <ConversionCTA
          title="Ankara'da Acil Çekiciye İhtiyacınız mı Var?"
          description="Konumunuzu paylaşın, aracınızın durumunu bildirin — en uygun çözümü birlikte bulalım."
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* Process */
.process-grid {
  display: grid; gap: 48px;
}
@media (min-width:1024px) { .process-grid { grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 64px; } }

.trust-pills-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
.trust-pill-item {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 600; color: #374151;
  padding: 7px 14px; border-radius: 999px;
  background: #f1f5f9; border: 1px solid rgba(15,23,42,0.08);
}

.process-steps { display: flex; flex-direction: column; gap: 12px; }
.process-card {
  display: flex; align-items: flex-start; gap: 16px;
  padding: 20px 22px;
  background: #ffffff;
  border: 1.5px solid rgba(15,23,42,0.08);
  border-radius: 16px;
  box-shadow: 0 2px 12px rgba(8,12,20,0.05);
  transition: border-color 240ms, box-shadow 240ms, transform 240ms cubic-bezier(0.22,1,0.36,1);
}
.process-card:hover { border-color: rgba(255,201,74,0.35); box-shadow: 0 8px 32px rgba(8,12,20,0.10); transform: translateY(-2px); }
.process-num {
  flex-shrink: 0; width: 44px; height: 44px;
  display: grid; place-items: center;
  border-radius: 12px; background: #080c14;
  font-size: 14px; font-weight: 800; color: #ffc94a;
}
.process-title { font-size: 0.9375rem; font-weight: 700; color: #080c14; letter-spacing: 0; margin: 0 0 4px; }
.process-desc  { font-size: 0.8125rem; line-height: 1.6; color: #64748b; margin: 0; }

/* Section header (title + link row) */
.section-header {
  display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;
}
@media (min-width:768px) { .section-header { flex-direction: row; align-items: flex-end; justify-content: space-between; } }

/* Services grid */
.services-grid {
  display: grid; gap: 16px;
  grid-template-columns: repeat(1, 1fr);
}
@media (min-width:640px)  { .services-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width:1024px) { .services-grid { grid-template-columns: repeat(3, 1fr); } }
.services-featured { grid-column: 1; }
@media (min-width:1024px) { .services-featured { grid-column: span 2; } }

/* Why us */
.whyus-grid {
  display: grid; gap: 12px;
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width:768px)  { .whyus-grid { grid-template-columns: repeat(4, 1fr); } }
.whyus-card {
  position: relative; overflow: hidden;
  padding: 26px 24px 24px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.10);
  background: linear-gradient(160deg, rgba(255,255,255,0.07), rgba(255,255,255,0.02));
  box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset;
  transition: border-color 280ms, transform 280ms cubic-bezier(0.22,1,0.36,1), box-shadow 280ms;
}
.whyus-card::before { content:''; position:absolute; inset:0; border-radius:20px; padding:1px; background:linear-gradient(160deg, rgba(255,201,74,0.45), transparent 50%); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:0; transition:opacity 280ms; pointer-events:none; }
.whyus-card:hover { transform: translateY(-4px); border-color: rgba(255,201,74,0.28); box-shadow: 0 18px 50px rgba(0,0,0,0.40); }
.whyus-card:hover::before { opacity:1; }
.whyus-ico {
  display: grid; place-items: center;
  width: 48px; height: 48px; border-radius: 14px;
  background: linear-gradient(150deg,#ffd664,#f5a900); color: #0a0e18;
  box-shadow: 0 8px 22px rgba(245,169,0,0.30); margin-bottom: 18px;
}
.whyus-title { font-size: 1rem; font-weight: 700; color: #fff; letter-spacing: -0.01em; margin: 0 0 8px; }
.whyus-desc { font-size: 0.85rem; font-weight: 400; line-height: 1.6; color: rgba(255,255,255,0.64); margin: 0; }
.whyus-index { position: absolute; top: 16px; right: 20px; font-size: 2rem; font-weight: 800; color: rgba(255,255,255,0.06); letter-spacing: -0.02em; }

/* Districts */
.districts-grid {
  display: grid; gap: 12px;
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width:768px)  { .districts-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width:1024px) { .districts-grid { grid-template-columns: repeat(4, 1fr); } }
</style>
