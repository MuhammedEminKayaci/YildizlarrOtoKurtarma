---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import DistrictHero from '@/components/DistrictHero.astro';
import DistrictScenarioGrid from '@/components/DistrictScenarioGrid.astro';
import DistrictServiceHighlights from '@/components/DistrictServiceHighlights.astro';
import DistrictLocalInfo from '@/components/DistrictLocalInfo.astro';
import DistrictNearbyLinks from '@/components/DistrictNearbyLinks.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import FAQ from '@/components/FAQ.astro';
import ConversionCTA from '@/components/ConversionCTA.astro';
import { site } from '@/data/site';
import { districtPages, type DistrictPage } from '@/data/districtPages';
import { districtSeoEnhancementBySlug } from '@/data/districtSeoEnhancements';
import { processSteps } from '@/data/processSteps';
import {
  createBreadcrumbSchema,
  createFAQSchema,
  createLocalBusinessSchema,
  createWebPageSchema
} from '@/lib/schema';

export function getStaticPaths() {
  return districtPages.map((district) => ({
    params: { slug: district.slug },
    props: { district }
  }));
}

interface Props {
  district: DistrictPage;
}

const { district } = Astro.props;
const canonical = `/ankara-cekici/${district.slug}/`;
const seoEnhancement = districtSeoEnhancementBySlug.get(district.slug);
const districtFaqs = [...district.faqs, ...(seoEnhancement?.faqs ?? [])];
const breadcrumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Ankara Çekici', href: '/ankara-cekici/' },
  { label: `${district.name} Çekici`, href: canonical }
];
---

<BaseLayout
  title={district.title}
  description={district.description}
  canonical={canonical}
  jsonLd={[
    createLocalBusinessSchema(district.name),
    createFAQSchema(districtFaqs),
    createBreadcrumbSchema(breadcrumbs),
    createWebPageSchema({
      title: district.title,
      description: district.description,
      url: canonical,
      name: district.h1,
      breadcrumbName: `${district.name} Çekici`
    })
  ]}
>
  <Breadcrumb items={breadcrumbs} />
  <DistrictHero name={district.name} h1={district.h1} shortIntro={district.shortIntro} />

  <section class="bg-white section-pad">
    <div class="site-container grid gap-10 md:grid-cols-[1fr_0.8fr] md:items-start">
      <div>
        <h2 class="text-3xl font-semibold text-ink-950 md:text-4xl">{district.name} bölgesinde oto çekici desteği</h2>
        <p class="mt-5 text-base leading-8 text-ink-600">{district.longIntro}</p>
      </div>
      <aside class="glass-card p-6">
        <h2 class="text-xl font-semibold text-ink-950">Yerel durum notu</h2>
        <p class="mt-4 text-sm leading-7 text-ink-600">{district.localFocus}</p>
      </aside>
    </div>
  </section>

  <section class="light-section section-pad">
    <div class="site-container">
      <SectionTitle
        eyebrow="Senaryolar"
        title={`${district.name} bölgesinde hangi durumlarda çekici gerekir?`}
        description="Araç arızası, kaza, servis taşıma veya konum kaynaklı erişim ihtiyaçları ilçe koşullarına göre değerlendirilir."
      />
      <div class="mt-10">
        <DistrictScenarioGrid items={district.commonScenarios} />
      </div>
    </div>
  </section>

  <section class="dark-section section-pad">
    <div class="site-container">
      <SectionTitle
        tone="dark"
        eyebrow="Hizmetler"
        title={`${district.name} için sunduğumuz hizmetler`}
        description="İhtiyaca göre oto çekici, yol yardım, kaza sonrası çekim veya planlı taşıma desteği sağlanır."
      />
      <div class="mt-10">
        <DistrictServiceHighlights items={district.serviceHighlights} />
      </div>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="site-container">
      <SectionTitle
        eyebrow="Yerel Bilgi"
        title={`${district.name} mahalleleri ve ana bağlantılar`}
        description="Aşağıdaki bölge ve yollar, çekici yönlendirmesinde konum tarifini kolaylaştıran önemli referanslardır."
      />
      <div class="mt-10">
        <DistrictLocalInfo neighborhoods={district.neighborhoods} mainRoads={district.mainRoads} />
      </div>
    </div>
  </section>

  {seoEnhancement && (
    <section class="light-section section-pad">
      <div class="site-container">
        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div>
            <SectionTitle
              eyebrow="Bölgesel Rehber"
              title={seoEnhancement.focusTitle}
              description={seoEnhancement.focusIntro}
            />
            <div class="mt-8 rounded-2xl border border-brand-300/35 bg-white p-6 shadow-soft">
              <h3 class="text-lg font-semibold text-ink-950">Konum paylaşırken işinizi kolaylaştıran bilgi</h3>
              <p class="mt-3 text-sm leading-7 text-ink-600">{seoEnhancement.callout}</p>
            </div>
          </div>

          <div class="grid gap-5">
            <article class="rounded-2xl border border-ink-950/10 bg-white p-6 shadow-soft">
              <h3 class="text-xl font-semibold text-ink-950">Rota ve erişim notları</h3>
              <ul class="mt-5 space-y-4">
                {seoEnhancement.routeNotes.map((note) => (
                  <li class="flex gap-3 text-sm leading-7 text-ink-600">
                    <span class="mt-2 size-2 shrink-0 rounded-full bg-brand-400" aria-hidden="true"></span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </article>

            <div class="grid gap-4 md:grid-cols-3">
              {seoEnhancement.serviceLinks.map((service) => (
                <a
                  href={service.href}
                  class="group rounded-2xl border border-ink-950/10 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300/60"
                >
                  <span class="text-sm font-semibold text-ink-950 group-hover:text-brand-700">{service.title}</span>
                  <span class="mt-3 block text-sm leading-6 text-ink-500">{service.description}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="light-section section-pad">
    <div class="site-container">
      <SectionTitle
        eyebrow="Süreç"
        title={`${district.name} çekici süreci nasıl ilerler?`}
        description={district.processNote}
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, index) => (
          <article class="glass-card p-6">
            <span class="grid size-10 place-items-center rounded-full bg-ink-950 text-sm font-bold text-brand-300">{index + 1}</span>
            <h3 class="mt-6 text-lg font-semibold text-ink-950">{step.title}</h3>
            <p class="mt-3 text-sm leading-6 text-ink-500">{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="site-container">
      <SectionTitle
        align="center"
        eyebrow="Sık Sorulanlar"
        title={`${district.name} oto çekici hakkında sorular`}
        description="İlçe özelindeki çekici ve araç taşıma süreciyle ilgili kısa yanıtlar."
      />
      <div class="mt-10">
        <FAQ items={districtFaqs} />
      </div>
    </div>
  </section>

  <DistrictNearbyLinks slugs={district.nearbyDistricts} />

  <section class="bg-white section-pad">
    <div class="site-container">
      <ConversionCTA
        title={`${district.name} bölgesinde çekiciye mi ihtiyacınız var?`}
        description={`Konumunuzu paylaşın; araç durumu, gidilecek nokta ve uygun taşıma sürecini ${site.name} ile netleştirin.`}
      />
    </div>
  </section>
</BaseLayout>
