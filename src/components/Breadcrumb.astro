---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  tone?: 'light' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
const isDark = tone === 'dark';
---

<nav class="site-container pt-6" aria-label="Breadcrumb">
  <ol class:list={['flex flex-wrap items-center gap-2 text-sm', isDark ? 'text-white/45' : 'text-ink-500']}>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {isLast ? (
            <span class:list={['font-medium', isDark ? 'text-white/80' : 'text-ink-800']} aria-current="page">{item.label}</span>
          ) : (
            <a class:list={['rounded-full px-2 py-1', isDark ? 'hover:bg-white/10 hover:text-white' : 'hover:bg-white hover:text-ink-950']} href={item.href}>{item.label}</a>
          )}
          {!isLast && <span class={isDark ? 'text-white/20' : 'text-ink-300'} aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>
