{icons[name] ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    class={className}
    aria-hidden={ariaHidden === true ? 'true' : ariaHidden}
    aria-label={ariaLabel}
    xmlns="http://www.w3.org/2000/svg"
    style={`stroke-width: ${strokeWidth};`}
  >
    <Fragment set:html={icons[name]} />
  </svg>
) : (
  <!-- Fallback: empty square if icon not found -->
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width={strokeWidth} opacity="0.3"/>
