---
import Icon from '@/components/Icon.astro';

interface FaqItem { question: string; answer: string; }
interface Props { items: FaqItem[]; }
const { items } = Astro.props;
---

<div class="faq-wrap">
  {items.map((item) => (
    <details class="faq-item" data-faq>
      <summary class="faq-summary">
        <span class="faq-q">{item.question}</span>
        <span class="faq-toggle" aria-hidden="true">
          <Icon name="chevron-down" size={16} strokeWidth={2.5} />
        </span>
      </summary>
      <div class="faq-body">
        <p class="faq-a">{item.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
.faq-wrap{max-width:760px;margin:0 auto;border:1.5px solid rgba(15,23,42,0.09);border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 4px 32px rgba(8,12,20,0.07);}
.faq-item{border-bottom:1px solid rgba(15,23,42,0.07);}
.faq-item:last-child{border-bottom:none;}
.faq-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 28px;cursor:pointer;list-style:none;user-select:none;transition:background 180ms;}
.faq-summary::-webkit-details-marker{display:none;}
.faq-summary:hover{background:#fafbfc;}
.faq-item[open] .faq-summary{background:#f5f7fb;}
.faq-q{font-size:0.9375rem;font-weight:600;color:#080c14;letter-spacing:0;line-height:1.45;}
.faq-toggle{flex-shrink:0;width:32px;height:32px;display:grid;place-items:center;border-radius:50%;background:#f1f5f9;color:#64748b;transition:background 200ms,color 200ms,transform 300ms cubic-bezier(0.22,1,0.36,1);}
.faq-item[open] .faq-toggle{background:#080c14;color:#ffc94a;transform:rotate(180deg);}
.faq-body{max-height:0;overflow:hidden;transition:max-height 350ms cubic-bezier(0.4,0,0.2,1);}
.faq-item[open] .faq-body{max-height:600px;}
.faq-a{padding:0 28px 22px;font-size:0.875rem;line-height:1.75;color:#64748b;margin:0;}
@media(max-width:640px){.faq-summary{padding:18px 20px;}.faq-a{padding:0 20px 18px;}}
</style>

<script>
  document.querySelectorAll('[data-faq]').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('[data-faq]').forEach(other => {
          if (other !== detail)(other as HTMLDetailsElement).open = false;
        });
      }
    });
  });
</script>
