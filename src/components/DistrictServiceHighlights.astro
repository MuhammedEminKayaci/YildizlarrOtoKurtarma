---
import ServiceIcon from '@/components/ServiceIcon.astro';

interface Highlight {
  title: string;
  description: string;
}

interface Props {
  items: Highlight[];
}

const { items } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-3">
  {items.map((item) => (
    <article class="rounded-apple border border-white/10 bg-white/10 p-6">
      <div class="mb-5 grid size-11 place-items-center rounded-2xl bg-brand-300 text-ink-950" aria-hidden="true">
        <ServiceIcon name={item.title} />
      </div>
      <h3 class="text-xl font-semibold text-white">{item.title}</h3>
      <p class="muted mt-3 text-sm leading-6">{item.description}</p>
    </article>
  ))}
</div>
