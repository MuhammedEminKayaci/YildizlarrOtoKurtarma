---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import Icon from '@/components/Icon.astro';
import { getBlogCoverBySlug } from '@/data/media';

interface Props {
  title: string;
  description: string;
  category: string;
  readingTime: string;
  publishDate: Date;
  href: string;
}

const { title, description, category, readingTime, publishDate, href } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(publishDate);
const slug = href.split('/').filter(Boolean).at(-1);
const coverImage = getBlogCoverBySlug(slug);
---

<article class="premium-card group flex h-full flex-col p-4 md:p-5">
  <div class="relative z-10 mb-5 aspect-[16/9] overflow-hidden rounded-3xl border border-white/70 bg-white shadow-soft">
    <ResponsiveImage image={coverImage} class="h-full w-full" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
  </div>
  <div class="relative z-10 flex flex-wrap items-center gap-2 text-xs font-semibold text-ink-500">
    <span class="rounded-full bg-brand-100 px-3 py-1 text-brand-700">{category}</span>
    <span>{formattedDate}</span>
    <span aria-hidden="true">·</span>
    <span>{readingTime}</span>
  </div>
  <h2 class="relative z-10 mt-5 text-xl font-semibold leading-tight text-ink-950">{title}</h2>
  <p class="relative z-10 mt-3 flex-1 text-sm leading-6 text-ink-500">{description}</p>
  <a class="relative z-10 mt-6 inline-flex text-sm font-semibold text-ink-950 group-hover:text-brand-700" href={href}>
    Rehberi oku
    <Icon name="arrow-right" size={15} strokeWidth={2} class="ml-2" />
  </a>
</article>
