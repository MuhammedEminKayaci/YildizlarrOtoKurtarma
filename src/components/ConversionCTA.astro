---
import { site } from '@/data/site';
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  description: string;
  variant?: 'dark' | 'light';
  showTrustItems?: boolean;
}
const { title, description, showTrustItems = true } = Astro.props;
---

<div class="cta-block">
  <!-- Background image layer -->
  <div class="cta-bg" aria-hidden="true">
    <img src="/images/optimized/stock/tow-truck-night.jpg" alt="" width="1400" height="1866"
      loading="lazy" decoding="async" class="cta-bg-img"/>
    <div class="cta-bg-overlay"></div>
  </div>

  <div class="cta-inner">
    <!-- Status -->
    <div class="cta-status">
      <span class="cta-status-dot"></span>
      Ankara genelinde şu an aktif
    </div>

    <h2 class="cta-title">{title}</h2>
    <p class="cta-desc">{description}</p>

    <div class="cta-buttons">
      <a href={site.phoneHref} class="cta-btn-primary">
        <Icon name="phone-call" size={18} strokeWidth={2} />
        {site.phoneDisplay}
      </a>
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="cta-btn-secondary">
        <Icon name="whatsapp" size={18} strokeWidth={1.75} />
        Konum Gönder
      </a>
    </div>

    {showTrustItems && (
      <p class="cta-trust">7/24 ulaşılabilir &nbsp;·&nbsp; Ankara geneli &nbsp;·&nbsp; Güvenli taşıma</p>
    )}
  </div>
</div>

<style>
.cta-block {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  min-height: 400px;
  display: flex;
  align-items: center;
}
.cta-bg { position: absolute; inset: 0; z-index: 0; }
.cta-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
.cta-bg-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(105deg, rgba(5,8,18,0.88) 0%, rgba(5,8,18,0.72) 55%, rgba(5,8,18,0.50) 100%);
}

.cta-inner {
  position: relative; z-index: 10;
  width: 100%;
  padding: 64px 56px;
  text-align: center;
  display: flex; flex-direction: column; align-items: center;
}
@media (max-width: 640px) { .cta-inner { padding: 48px 28px; } }

.cta-status {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 600; color: #34d399;
  border: 1px solid rgba(52, 211, 153, 0.30);
  background: rgba(52, 211, 153, 0.10);
  border-radius: 999px; padding: 6px 14px;
  margin-bottom: 24px;
}
.cta-status-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #12b981; flex-shrink: 0;
  box-shadow: 0 0 0 3px rgba(18,185,129,0.25);
  animation: pulse-dot 2.4s ease-in-out infinite;
}

.cta-title {
  font-size: clamp(1.75rem, 4vw, 3rem);
  font-weight: 700; color: #ffffff;
  letter-spacing: 0; line-height: 1.1;
  max-width: 640px; margin: 0 0 16px;
}
.cta-desc {
  font-size: 1rem; line-height: 1.7;
  color: rgba(255,255,255,0.65);
  max-width: 520px; margin: 0 0 36px;
}
.cta-buttons {
  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
  margin-bottom: 24px;
}
.cta-btn-primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 16px 32px; border-radius: 14px;
  background: #ffc94a; color: #080c14;
  font-size: 1rem; font-weight: 700; text-decoration: none;
  box-shadow: 0 4px 0 rgba(0,0,0,0.18), 0 12px 36px rgba(255,201,74,0.32);
  transition: background 200ms, transform 200ms, box-shadow 200ms;
  white-space: nowrap;
}
.cta-btn-primary:hover { background: #ffd46a; transform: translateY(-2px); box-shadow: 0 4px 0 rgba(0,0,0,0.14), 0 20px 52px rgba(255,201,74,0.42); }
.cta-btn-secondary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 16px 24px; border-radius: 14px;
  border: 1.5px solid rgba(255,255,255,0.22);
  background: rgba(255,255,255,0.08);
  color: #ffffff; font-size: 1rem; font-weight: 600;
  text-decoration: none; backdrop-filter: blur(12px);
  transition: border-color 200ms, background 200ms, transform 200ms;
  white-space: nowrap;
}
.cta-btn-secondary:hover { border-color: rgba(255,255,255,0.40); background: rgba(255,255,255,0.14); transform: translateY(-1px); }

.cta-trust { font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.38); margin: 0; }

@keyframes pulse-dot {
  0%,100% { box-shadow: 0 0 0 3px rgba(18,185,129,0.25); }
  50% { box-shadow: 0 0 0 6px rgba(18,185,129,0.10); }
}
</style>
