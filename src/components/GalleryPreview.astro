---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import Icon from '@/components/Icon.astro';
import { media } from '@/data/media';

const galleryCrop = (image: (typeof media.services)[keyof typeof media.services], filename: string) => ({
  ...image,
  src: `/images/gallery/heavy-transport/${filename}`,
  webp: undefined,
  width: 1200,
  height: 900
});
const newTransportImages = [
  galleryCrop(media.services.largeVehicleTransport, 'kayar-kasa-buyuk-arac-tasima.jpg'),
  galleryCrop(media.services.forkliftTransport, 'forklift-tasima.jpg'),
  galleryCrop(media.services.manliftTransport, 'manlift-tasima.jpg'),
  galleryCrop(media.services.truckTransport, 'kamyon-tasima.jpg'),
  galleryCrop(media.services.tractorTransport, 'traktor-tasima.jpg'),
  galleryCrop(media.services.compactMachineTransport, 'is-makinesi-tasima.jpg'),
  galleryCrop(media.services.manliftTransportVertical, 'manlift-kayar-kasa.jpg')
];
const images = [...newTransportImages, ...media.galleryImages.slice(0, 5)];
---

<section class="gal-section">
  <div class="site-container">

    <div class="gal-header reveal">
      <div>
        <p class="section-eyebrow" style="margin-bottom:14px">Galeri</p>
        <h2 class="section-heading">Operasyondan Kareler</h2>
        <p class="gal-sub">Büyük ticari araç, forklift, manlift, traktör, iş makinesi ve otomobil taşıma operasyonlarımızdan gerçek saha görüntüleri.</p>
      </div>
      <a class="btn-secondary btn-arrow" href="/iletisim/" style="flex-shrink:0">İletişime Geçin <Icon name="arrow-right" size={16} strokeWidth={2.25} /></a>
    </div>

    <div class="gal-grid">
      {images.map((image, index) => (
        <button
          type="button"
          class:list={['gal-item', index === 0 && 'gal-item--large']}
          data-gal-open
          data-src={image.src}
          data-caption={image.caption ?? ''}
          data-alt={image.alt}
          aria-label={`${image.caption ?? 'Operasyon karesi'} — büyüt`}
        >
          <ResponsiveImage
            image={image}
            class="gal-img"
            rounded={false}
            sizes={index === 0
              ? '(min-width:1024px) 50vw, 100vw'
              : '(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw'}
          />
          <div class="gal-overlay" aria-hidden="true">
            {image.caption && <span class="gal-caption">{image.caption}</span>}
            <span class="gal-zoom"><Icon name="arrow-right" size={15} strokeWidth={2.25} /></span>
          </div>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox -->
<div class="gal-lb" data-gal-lb aria-hidden="true" role="dialog" aria-modal="true" aria-label="Galeri görüntüleyici">
  <button class="gal-lb-close" type="button" data-gal-close aria-label="Kapat"><Icon name="x" size={22} /></button>
  <button class="gal-lb-nav gal-lb-prev" type="button" data-gal-prev aria-label="Önceki"><Icon name="chevron-right" size={26} /></button>
  <figure class="gal-lb-figure">
    <img class="gal-lb-img" data-gal-img src="" alt="" />
    <figcaption class="gal-lb-cap" data-gal-cap></figcaption>
  </figure>
  <button class="gal-lb-nav gal-lb-next" type="button" data-gal-next aria-label="Sonraki"><Icon name="chevron-right" size={26} /></button>
</div>

<style>
.gal-section { padding: 80px 0 96px; background: #f5f7fb; }
@media (min-width:768px) { .gal-section { padding: 96px 0 112px; } }

.gal-header { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
@media (min-width:768px) { .gal-header { flex-direction: row; align-items: flex-end; justify-content: space-between; } }
.gal-sub { margin-top: 10px; font-size: 1rem; line-height: 1.65; color: #64748b; max-width: 480px; }

.gal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
@media (min-width:1024px) {
  .gal-grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 196px; }
}

.gal-item {
  position: relative; overflow: hidden; border-radius: 16px;
  aspect-ratio: 4/3; background: #e2e8f0;
  border: 0; padding: 0; cursor: pointer; display: block; width: 100%;
  box-shadow: 0 2px 10px rgba(8,12,20,0.06);
}
.gal-item::after {
  content: ''; position: absolute; inset: 0; border-radius: 16px;
  box-shadow: inset 0 0 0 1px rgba(15,23,42,0.06); pointer-events: none; z-index: 3;
}
@media (min-width:1024px) {
  .gal-item { aspect-ratio: unset; }
  .gal-item--large { grid-column: span 2; grid-row: span 2; }
}

.gal-img { width: 100%; height: 100%; display: block; background: #e2e8f0; transition: transform 600ms cubic-bezier(0.22,1,0.36,1); }
.gal-item:hover .gal-img, .gal-item:focus-visible .gal-img { transform: scale(1.07); }

.gal-overlay {
  position: absolute; inset: 0; z-index: 2;
  background: linear-gradient(to top, rgba(6,9,16,0.72) 0%, rgba(6,9,16,0.10) 42%, transparent 70%);
  opacity: 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 10px;
  padding: 14px 14px 15px; transition: opacity 280ms ease;
}
.gal-item:hover .gal-overlay, .gal-item:focus-visible .gal-overlay { opacity: 1; }
.gal-caption { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: 0.01em; text-shadow: 0 1px 8px rgba(0,0,0,0.4); }
.gal-zoom {
  flex-shrink: 0; display: grid; place-items: center; width: 30px; height: 30px;
  border-radius: 999px; background: #ffc94a; color: #080c14;
  transform: rotate(-45deg); transition: transform 280ms ease;
}
.gal-item:hover .gal-zoom { transform: rotate(-45deg) scale(1.08); }

/* Lightbox */
.gal-lb {
  position: fixed; inset: 0; z-index: 120;
  display: flex; align-items: center; justify-content: center;
  gap: 8px; padding: 20px;
  background: rgba(5,8,16,0.92); backdrop-filter: blur(8px);
  opacity: 0; pointer-events: none; transition: opacity 260ms ease;
}
.gal-lb.open { opacity: 1; pointer-events: auto; }
.gal-lb-figure { margin: 0; max-width: min(1100px, 92vw); max-height: 86vh; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.gal-lb-img {
  max-width: 100%; max-height: 78vh; object-fit: contain;
  border-radius: 12px; box-shadow: 0 30px 90px rgba(0,0,0,0.55);
  background: #0b0f18; transform: scale(0.97); transition: transform 300ms cubic-bezier(0.22,1,0.36,1);
}
.gal-lb.open .gal-lb-img { transform: scale(1); }
.gal-lb-cap { color: rgba(255,255,255,0.86); font-size: 14px; font-weight: 600; text-align: center; }
.gal-lb-close {
  position: absolute; top: 18px; right: 18px; z-index: 5;
  display: grid; place-items: center; width: 46px; height: 46px; border-radius: 999px;
  background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.16); color: #fff; cursor: pointer;
  transition: background 180ms; backdrop-filter: blur(6px);
}
.gal-lb-close:hover { background: rgba(255,255,255,0.20); }
.gal-lb-nav {
  display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px;
  background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.16); color: #fff; cursor: pointer;
  flex-shrink: 0; transition: background 180ms; backdrop-filter: blur(6px);
}
.gal-lb-nav:hover { background: rgba(255,255,255,0.22); }
.gal-lb-prev { transform: rotate(180deg); }
@media (max-width: 640px) {
  .gal-lb-nav { position: absolute; bottom: 22px; width: 44px; height: 44px; }
  .gal-lb-prev { left: 24px; }
  .gal-lb-next { right: 24px; }
}
</style>

<script>
  const lb = document.querySelector('[data-gal-lb]') as HTMLElement | null;
  const lbImg = document.querySelector('[data-gal-img]') as HTMLImageElement | null;
  const lbCap = document.querySelector('[data-gal-cap]') as HTMLElement | null;
  const triggers = Array.from(document.querySelectorAll('[data-gal-open]')) as HTMLElement[];
  let index = 0;

  const items = triggers.map(t => ({
    src: t.getAttribute('data-src') || '',
    caption: t.getAttribute('data-caption') || '',
    alt: t.getAttribute('data-alt') || ''
  }));

  const render = () => {
    if (!lbImg || !lbCap) return;
    const it = items[index];
    lbImg.src = it.src;
    lbImg.alt = it.alt;
    lbCap.textContent = it.caption;
  };
  const open = (i: number) => {
    index = i; render();
    lb?.classList.add('open'); lb?.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  };
  const close = () => {
    lb?.classList.remove('open'); lb?.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  };
  const step = (d: number) => { index = (index + d + items.length) % items.length; render(); };

  triggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
  document.querySelector('[data-gal-close]')?.addEventListener('click', close);
  document.querySelector('[data-gal-prev]')?.addEventListener('click', () => step(-1));
  document.querySelector('[data-gal-next]')?.addEventListener('click', () => step(1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });
</script>
