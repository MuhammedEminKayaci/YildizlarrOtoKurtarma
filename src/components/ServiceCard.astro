---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import Icon from '@/components/Icon.astro';
import { getServiceImageByTitle } from '@/data/media';

interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href = '/hizmetler/' } = Astro.props;
const serviceImage = getServiceImageByTitle(title);
---

<article class="svc-card group">
  <!-- Photo -->
  <div class="svc-card-photo">
    <ResponsiveImage
      image={serviceImage}
      class="svc-card-img"
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      rounded={false}
    />
    <!-- Dark scrim at bottom of photo -->
    <div class="svc-card-photo-scrim" aria-hidden="true"></div>
  </div>

  <!-- Body -->
  <div class="svc-card-body">
    <h3 class="svc-card-title">{title}</h3>
    <p class="svc-card-desc">{description}</p>

    <a href={href} class="svc-card-link" aria-label={`${title} detayları`}>
      Detayları incele
      <Icon name="arrow-right" size={16} strokeWidth={2} />
    </a>
  </div>
</article>

<style>
.svc-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #ffffff;
  border-radius: 20px;
  border: 1px solid rgba(15, 23, 42, 0.08);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(8,12,20,0.04), 0 8px 28px rgba(8,12,20,0.08);
  transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow 280ms ease,
              border-color 280ms ease;
}
.svc-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 12px rgba(8,12,20,0.06), 0 18px 52px rgba(8,12,20,0.14);
  border-color: rgba(255, 201, 74, 0.35);
}

.svc-card-photo {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  flex-shrink: 0;
}
.svc-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
}
.group:hover .svc-card-img {
  transform: scale(1.05);
}
.svc-card-photo-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(8, 12, 20, 0.28), transparent 60%);
  pointer-events: none;
}

.svc-card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 22px 24px 24px;
}
.svc-card-title {
  font-size: 1.0625rem;
  font-weight: 700;
  color: #080c14;
  letter-spacing: 0;
  margin: 0 0 8px 0;
}
.svc-card-desc {
  font-size: 0.875rem;
  line-height: 1.65;
  color: #5a6473;
  flex: 1;
  margin: 0 0 20px 0;
}
.svc-card-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  color: #080c14;
  text-decoration: none;
  transition: gap 200ms ease, color 200ms ease;
}
.group:hover .svc-card-link {
  gap: 10px;
  color: #d08a00;
}
</style>
