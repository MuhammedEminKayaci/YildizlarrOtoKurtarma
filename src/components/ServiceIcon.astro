---
interface Props {
  name: string;
}

const { name } = Astro.props;
const key = name.toLocaleLowerCase('tr-TR');
const type = key.includes('motosiklet')
  ? 'motorcycle'
  : key.includes('kaza')
    ? 'accident'
    : key.includes('şehir') || key.includes('taşıma')
      ? 'transport'
      : key.includes('yol')
        ? 'roadside'
        : key.includes('otopark') || key.includes('servis')
          ? 'support'
          : 'tow';
---

<svg class="size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {type === 'tow' && (
    <>
      <path d="M4 14h9l3-5h3v5h1.5a1.5 1.5 0 0 1 1.5 1.5V18h-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 18h2m5 0h5M5 14l2-5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="8.5" cy="18" r="2" stroke="currentColor" stroke-width="1.8" />
      <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.8" />
    </>
  )}
  {type === 'roadside' && (
    <>
      <path d="M12 3v18M7 21l5-18 5 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path d="M8.5 9h7M7.5 14h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </>
  )}
  {type === 'accident' && (
    <>
      <path d="M12 3 2.8 20h18.4L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      <path d="M12 9v4m0 4h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {type === 'transport' && (
    <>
      <path d="M3 15h12l2-4h4v4h1v3h-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M3 18h3m5 0h5M6 12h7M8 8h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="8.5" cy="18" r="2" stroke="currentColor" stroke-width="1.8" />
      <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.8" />
    </>
  )}
  {type === 'motorcycle' && (
    <>
      <circle cx="6" cy="17" r="3" stroke="currentColor" stroke-width="1.8" />
      <circle cx="18" cy="17" r="3" stroke="currentColor" stroke-width="1.8" />
      <path d="M8.5 17h3l2.5-5h-3l-2-3m5 3 3.5 5M9 9h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {type === 'support' && (
    <>
      <path d="M12 3a7 7 0 0 0-7 7v3a3 3 0 0 0 3 3h1v-6H5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M12 3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1v-6h4M15 19c-1 1-2 1.5-3 1.5S10 20 9 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>
